{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "LiveViewEngine": {
    "TypedColumnKeepAlive": "WhenReferencedByIndexes",
    "StaleIndexGracePeriod": "00:00:30",
    "SnapshotBatchSize": 128,
    "EagerIndexing": false
  },
  "TcpIngest": {
    "EnableAsyncAcks": true
  },
  "AllowedHosts": "*"
}
