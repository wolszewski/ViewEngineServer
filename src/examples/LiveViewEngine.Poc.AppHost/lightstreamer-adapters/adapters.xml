<?xml version="1.0"?>
<adapters_conf id="TRADES">
    <metadata_provider>
        <adapter_class>com.lightstreamer.adapters.metadata.LiteralBasedProvider</adapter_class>
    </metadata_provider>

    <data_provider name="trades-merge-adapter">
        <adapter_class>ROBUST_PROXY_FOR_REMOTE_ADAPTER</adapter_class>
        <classloader>log-enabled</classloader>
        <param name="request_reply_port">6661</param>
        <param name="status_item">adapter_status</param>
        <param name="timeout">-1</param>
        <param name="connection_recovery_timeout_millis">1000</param>
        <param name="unsubscription_timeout_millis">-1</param>
    </data_provider>

    <data_provider name="trades-command-adapter">
        <adapter_class>ROBUST_PROXY_FOR_REMOTE_ADAPTER</adapter_class>
        <classloader>log-enabled</classloader>
        <param name="request_reply_port">6662</param>
        <param name="status_item">adapter_status</param>
        <param name="timeout">-1</param>
        <param name="connection_recovery_timeout_millis">1000</param>
        <param name="unsubscription_timeout_millis">-1</param>
    </data_provider>
</adapters_conf>

