@page "/"
@rendermode InteractiveServer
@using Lightstreamer.DataProvider.Services
@using LiveViewEngine.Poc.Shared
@inject TradeGeneratorService TradeGenerator
@inject TradeGenerationSettingsStore GenerationSettingsStore
@implements IDisposable

<PageTitle>Lightstreamer DataProvider</PageTitle>

<div class="container py-4">
    <h1>Lightstreamer DataProvider</h1>
    <p class="text-muted">Configure trade generation and feed data into Lightstreamer via the remote adapter.</p>

    <div class="row g-3 mt-2">
        <div class="col-md-4">
            <label class="form-label">Initial trades</label>
            <input class="form-control" type="number" @bind="_settings.InitialTradeCount" @bind:after="PersistSettings" min="1" />
        </div>
        <div class="col-md-4">
            <label class="form-label">Fields updated per update</label>
            <input class="form-control" type="number" @bind="_settings.UpdateFieldCount" @bind:after="PersistSettings" min="1" max="10" />
        </div>
        <div class="col-md-4">
            <label class="form-label">Update frequency (updates/sec)</label>
            <input class="form-control" type="number" @bind="_settings.UpdateFrequencyHz" @bind:after="PersistSettings" min="1" />
        </div>
    </div>

    <div class="mt-4">
        <h5>Updatable fields <small class="text-muted fw-normal">(initial inserts always send all fields)</small></h5>
        <div class="mb-2">
            <button class="btn btn-sm btn-outline-secondary me-1" @onclick="SelectAllFields">All</button>
            <button class="btn btn-sm btn-outline-secondary me-2" @onclick="ClearAllFields">None</button>
            @foreach (var group in _fieldsByType)
            {
                var groupCapture = group.Value;
                var label = group.Key;
                <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => ToggleTypeGroup(groupCapture)">@label</button>
            }
        </div>
        <div class="d-flex flex-wrap gap-2">
            @foreach (var field in _updatableFieldNames)
            {
                var fieldCapture = field;
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="checkbox"
                           id="field-@fieldCapture"
                           checked="@_selectedFields.Contains(fieldCapture)"
                           @onchange="e => ToggleField(fieldCapture, (bool)(e.Value ?? false))" />
                    <label class="form-check-label" for="field-@fieldCapture">@fieldCapture</label>
                </div>
            }
        </div>
    </div>

    <div class="mt-4 d-flex gap-2">
        <button class="btn btn-outline-secondary" @onclick="StopGeneration">Stop</button>
    </div>

    <div class="card mt-4">
        <div class="card-body">
            <h5 class="card-title">Status</h5>
            <p class="mb-1"><strong>Running:</strong> @_status.IsRunning</p>
            <p class="mb-1"><strong>Update mode:</strong> @_status.IsInUpdateMode</p>
            <p class="mb-1"><strong>Trades generated:</strong> @_status.TradesGenerated</p>
            <p class="mb-1"><strong>Updates sent:</strong> @_status.UpdatesSent</p>
            <p class="mb-1"><strong>Updates/s:</strong> @(_status.UpdatesPerSecond > 0 ? $"{_status.UpdatesPerSecond:F1}" : "—")</p>
            <p class="mb-1"><strong>Message:</strong> @_status.StatusMessage</p>
            @if (!string.IsNullOrWhiteSpace(_status.LastError))
            {
                <p class="text-danger mb-0"><strong>Last error:</strong> @_status.LastError</p>
            }
        </div>
    </div>
</div>

@code {
    private readonly TradeGenerationSettings _settings = new();
    private TradeGenerationStatus _status = TradeGenerationStatus.Idle();
    private IReadOnlyList<string> _updatableFieldNames = [];
    private IReadOnlyDictionary<string, IReadOnlyList<string>> _fieldsByType = new Dictionary<string, IReadOnlyList<string>>();
    private HashSet<string> _selectedFields = [];
    private Timer? _statusRefreshTimer;

    protected override void OnInitialized()
    {
        _status = TradeGenerator.Status;
        _updatableFieldNames = TradeGenerator.UpdatableFieldNames;
        _fieldsByType = TradeGenerator.UpdatableFieldNamesByType;
        _selectedFields = [.._updatableFieldNames];
        PersistSettings();
        TradeGenerator.StateChanged += HandleStatusChanged;
        _statusRefreshTimer = new Timer(
            _ => _ = InvokeAsync(RefreshStatusAsync),
            null,
            TimeSpan.FromMilliseconds(250),
            TimeSpan.FromMilliseconds(250));
    }

    private void PersistSettings()
    {
        var request = new TradeGenerationSettings
        {
            InitialTradeCount = _settings.InitialTradeCount,
            UpdateFieldCount = _settings.UpdateFieldCount,
            UpdateFrequencyHz = _settings.UpdateFrequencyHz,
            OrderedUpdates = _settings.OrderedUpdates,
            UpdatableFields = _selectedFields.Count == _updatableFieldNames.Count
                ? null
                : [.._selectedFields]
        };

        GenerationSettingsStore.Update(request);
    }

    private void StopGeneration() => TradeGenerator.StopGeneration();

    private void ToggleField(string field, bool selected)
    {
        if (selected) { _selectedFields.Add(field); }
        else { _selectedFields.Remove(field); }
        PersistSettings();
    }

    private void SelectAllFields()
    {
        _selectedFields = [.._updatableFieldNames];
        PersistSettings();
    }

    private void ClearAllFields()
    {
        _selectedFields = [];
        PersistSettings();
    }

    private void ToggleTypeGroup(IReadOnlyList<string> fields)
    {
        if (fields.All(_selectedFields.Contains))
        {
            foreach (var f in fields) { _selectedFields.Remove(f); }
        }
        else
        {
            foreach (var f in fields) { _selectedFields.Add(f); }
        }

        PersistSettings();
    }

    private void HandleStatusChanged()
    {
        _ = InvokeAsync(RefreshStatusAsync);
    }

    private Task RefreshStatusAsync()
    {
        _status = TradeGenerator.Status;
        StateHasChanged();
        return Task.CompletedTask;
    }

    public void Dispose()
    {
        TradeGenerator.StateChanged -= HandleStatusChanged;
        _statusRefreshTimer?.Dispose();
    }
}
